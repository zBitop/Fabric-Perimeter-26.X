{
	"schemaVersion": 1,
	"id": "perimeter",
	"version": "${version}",
	"name": "Perimeter",
	"description": "This is a mod that lets you create perimeters and collect all the items. It's a great way to save yourself from building TNT flying machines or mining everything by hand.",
	"authors": [
		"Bitop!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT-License",
	"icon": "assets/perimeter/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"zbitop.perimeter.Perimeter"
		],
		"fabric-datagen": [
			"zbitop.perimeter.PerimeterDataGenerator"
		]
	},
	"mixins": [
		"perimeter.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}